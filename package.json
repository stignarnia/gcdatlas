{
  "name": "gcdatlas",
  "version": "0.9.3",
  "private": true,
  "description": "The real universe drawn entirely in ASCII: an explorable WebGL2 atlas with seamless zoom from Earth to the edge of the observable universe.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node tests/smoke.mjs && node tests/mobile.mjs && node tests/motion.mjs && node tests/wallpaper.mjs",
    "test:tour": "node build.mjs && node tests/tour.mjs",
    "test:mobile": "node build.mjs && node tests/mobile.mjs",
    "test:motion": "node build.mjs && node tests/motion.mjs",
    "test:music": "node build.mjs && node tests/music.mjs",
    "test:wallpaper": "node build.mjs && node tests/wallpaper.mjs",
    "wallpaper": "node kde-wallpaper/package.mjs",
    "wallpaper:install": "node kde-wallpaper/package.mjs --install",
    "shots": "node tests/shots.mjs",
    "lab": "node build.mjs && node tools/lab-shots.mjs",
    "catalog": "node build.mjs && node tools/catalog.mjs",
    "lights": "node tools/earth-lights.mjs",
    "dev": "npx vercel dev",
    "showcase:video": "node build.mjs && node tools/showcase-video.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "^1.49.0",
    "sharp": "^0.35.4"
  }
}
